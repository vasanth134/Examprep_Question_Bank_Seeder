{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "drizzle-orm": ["../../examprep-backend/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../examprep-backend/node_modules/drizzle-orm/*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
