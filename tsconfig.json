{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/client/src/*"],
      "@shared/*": ["src/shared/*"],
      "drizzle-orm": ["../../examprep-backend/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../examprep-backend/node_modules/drizzle-orm/*"]
    },
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
