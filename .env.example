# ── Question Bank Seeder Studio Configuration ────────────────────────────────
PORT=4500
NODE_ENV=development

# ── Google Gemini AI Configuration ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Multi-Tenant Control Database ─────────────────────────────────────────────
CONTROL_DATABASE_URL=postgresql://postgres:user:password@localhost:5432/academic-os-dev-control
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password

# ── AWS S3 Asset Storage (Optional) ──────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
