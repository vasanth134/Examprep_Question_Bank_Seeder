{
  "name": "question-bank-seeder",
  "version": "1.0.0",
  "description": "Standalone Developer Tool for PDF Question Extraction, KaTeX Verification & Tenant Database Seeding",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"tsx watch src/server.ts\" \"vite\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "vite build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "multer": "1.4.5-lts.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.18.0",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
